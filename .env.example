# Copy to .env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
QDRANT_API_KEY=
S3_ACCESS_KEY=rag-minio
S3_SECRET_KEY=
S3_BUCKET=rag-uploads

# Used when running the API/worker on the host (outside containers)
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME@localhost:5432/rag
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
OLLAMA_BASE_URL=http://localhost:11434

# LLM providers (optional individually; routes skip providers without keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini

# Embeddings: ollama (bge-m3, 1024-d) or openai (text-embedding-3-small, 1536-d). Changing = reindex.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# HTTP
PUBLIC_UI_URL=http://localhost:8501
CORS_ORIGINS='["http://localhost:8501"]'
ALLOWED_HOSTS='["localhost","127.0.0.1","api"]'

# Email (Mailpit locally; real provider in prod with SMTP_TLS=true, SMTP_PORT=587)
SMTP_FROM="RAG <no-reply@localhost>"
SMTP_TLS=false

# Host port overrides (only if the defaults clash with other local services)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# POSTGRES_HOST_PORT=5432
