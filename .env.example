# Copy to .env and fill in. Never commit .env.
ENV=dev
SIGNUP_ENABLED=true  # set false for invitation-only accounts
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag
QDRANT_API_KEY=
S3_ACCESS_KEY=rag-minio
S3_SECRET_KEY=
S3_BUCKET=rag-uploads

# Used when running the API/worker on the host (outside containers)
DATABASE_URL=postgresql+asyncpg://rag:CHANGE_ME@localhost:5432/rag
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000
OLLAMA_BASE_URL=http://localhost:11434

# LLM providers (optional individually; routes skip providers without keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini
# Receipt extraction (route receipt_extraction): local vision model first, then Claude, then OpenAI.
OLLAMA_VISION_MODEL=qwen3-vl:latest
OPENAI_VISION_MODEL=gpt-5-mini

# Embeddings: ollama (bge-m3, 1024-d) or openai (text-embedding-3-small, 1536-d). Changing = reindex.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# Web UI (Next.js BFF). Encrypts the session cookie; rotating it signs everyone out.
SESSION_SECRET=
# Public origin of the web UI. Must be https in prod (CSRF origin check, Secure/__Host- cookie, HSTS).
WEB_ORIGIN=http://localhost:3000
# Leave 0 for direct access. Set 1 only behind an ingress that supplies the actual peer IP.
TRUSTED_PROXY_HOPS=0

# HTTP. Email links (signup, invites, password reset) point at the web UI.
PUBLIC_UI_URL=http://localhost:3000
CORS_ORIGINS='["http://localhost:8501"]'
ALLOWED_HOSTS='["localhost","127.0.0.1","api"]'

# Email (Mailpit locally; real provider in prod with SMTP_TLS=true, SMTP_PORT=587)
SMTP_FROM="Moontig <no-reply@localhost>"
SMTP_TLS=false

# Observability (ARCHITECTURE §5.3). /metrics is open in dev; in prod it needs METRICS_TOKEN or returns 404.
# METRICS_TOKEN=
# Traces over OTLP/HTTP: http://jaeger:4318 with `--profile observability`, or Langfuse at
# https://<host>/api/public/otel with OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 public:secret>".
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# Share (0-1) of cited answers graded asynchronously by the eval_judge route (sends context to that provider).
ONLINE_EVAL_SAMPLE_RATE=0
# GRAFANA_ADMIN_PASSWORD=admin

# Host port overrides (only if the defaults clash with other local services)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# POSTGRES_HOST_PORT=5432
# GRAFANA_HOST_PORT=3001
